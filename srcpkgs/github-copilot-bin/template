	23918b5067222bd17c0d87e948012e9f34b1ccbd38350977cfa984cf2a479fc9"
nopie=yes
restricted=yes

do_extract() {
	vsrccopy LICENSE.md "${wrksrc}"
	vsrcextract --strip-components=0 -C ${wrksrc} copilot-linux-x64.tar.gz
}

do_install() {
	vlicense LICENSE.md LICENSE
	vbin copilot
}
