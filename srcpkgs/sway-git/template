# Template file for 'sway-git'
pkgname=sway-git
version=1.12.rc1
revision=1
build_style=meson
configure_args="-Dwerror=false -Db_ndebug=false"
conf_files="/etc/sway/config"
hostmakedepends="pkg-config wayland-devel scdoc git"
makedepends="wlroots0.21-devel pcre2-devel json-c-devel pango-devel cairo-devel
 gdk-pixbuf-devel libevdev-devel"
depends="libcap-progs swaybg xorg-server-xwayland libxkbcommon>=1.5.0_1
 virtual?font:sans-serif"
short_desc="Tiling Wayland compositor compatible with i3"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://swaywm.org"

do_fetch() {
	git clone https://github.com/swaywm/sway.git ${wrksrc}
	cd ${wrksrc}
	git reset --hard c857ca3a978896f4f9bdd481ec5cf395662a2dc5
}

post_install() {
	vlicense LICENSE
}
